"""
pomi_coder_engine.py
────────────────────
POMI BQ Coding Engine

Three-stage pipeline:
  Stage 1 → Keyword rules  (instant, free, deterministic)
  Stage 2 → Fuzzy match    (fallback, capped at 79%, always flagged)
  Stage 3 → AI batch       (Claude API, only for items that fail both above)

Usage:
  from pomi_coder_engine import BQCodingEngine

  engine = BQCodingEngine(pomi_path='POMI_CODING_FINAL.xlsx')
  results = engine.code_items(items)          # items = list of str
  results = engine.code_items(items, use_ai=True, batch_size=10)
"""

import os, json, time, re, textwrap
from typing import Optional
from pomi_rules import RULES, LEARNED_RULES

try:
    from rapidfuzz import fuzz
    _FUZZY_OK = True
except ImportError:
    _FUZZY_OK = False
    print("  ⚠  rapidfuzz not installed — fuzzy fallback disabled.  pip install rapidfuzz")

try:
    from openpyxl import load_workbook
    _OPENPYXL_OK = True
except ImportError:
    _OPENPYXL_OK = False
    print("  ⚠  openpyxl not installed.  pip install openpyxl")

# ─── Section hint keywords (for fuzzy bias) ───────────────────────────────────
HINT_KW = {
    'A': ['preliminary','prelim','allow for','bwic','testing','commissioning',
          'professional fee','statutory','administration'],
    'B': ['excavat','earthwork','pil','borehole','anti-termite','dewater',
          'backfill','shoring','disposal','filling'],
    'C': ['concrete','blinding','reinforcement','formwork','slab','beam',
          'column','corbel','rebar','mesh'],
    'D': ['masonry','blockwork','brick','hollow concrete block','stonework'],
    'E': ['metalwork','handrail','balustrade','crash handrail','steelwork'],
    'F': ['woodwork','joinery','timber','countertop','cabinet','di-noc',
          'bespoke','reception counter','vanity'],
    'G': ['waterproof','moisture','waterproofing membrane','damp proof'],
    'H': ['door','window','ironmongery','glazing','curtain wall',
          'type ds-','type id-','type ft','revolving','roller shutter'],
    'J': ['screed','tile','paint','plaster','ceiling','skirting','lightcove',
          'bulkhead','cladding','type tl-','type mt-','type pt-',
          'type ep-','type pl-','emulsion','epoxy'],
    'K': ['partition','drywall','cubicle','accessories','signage','mirror',
          'planting','palm','tree','shrub'],
    'M': ['furniture','sofa','chair','table','bench','armchair','planter',
          'loose','type i-ba','type i-ch','type i-so','type i-ta'],
    'N': ['water feature','special construction'],
    'P': ['elevator','lift','escalator','travelator','conveying',
          'ref. pe-','ref. se-','ref. z','loading dock'],
    'Q': ['mechanical','pipe','duct','valve','hvac','drainage','irrigation',
          'sprinkler','drain','pump','wc','faucet','flush','urinal',
          'fcu','ewh','chilled water','ductwork','ventilation'],
    'R': ['electrical','cable','tray','distribution','lighting','socket',
          'alarm','cctv','from mdb','from smdb','from db','tcl =',
          'type fl','type il','type dl','type sl','type ll','type e1'],
}

# ─── POMI Section metadata (for AI prompt context) ────────────────────────────
SECTION_META = {
    'A': 'General Requirements (Preliminaries)',
    'B': 'Site Work (Excavation, Piling, Earthworks)',
    'C': 'Concrete (In-situ, Reinforcement, Formwork)',
    'D': 'Masonry (Blockwork, Brickwork)',
    'E': 'Metalwork (Structural, Handrails, Balustrades)',
    'F': 'Woodwork / Joinery (Bespoke Joinery, Cladding)',
    'G': 'Thermal & Moisture Protection (Waterproofing)',
    'H': 'Doors & Windows (Doors, Glazing, Curtain Wall)',
    'J': 'Finishes (Screed, Tiles, Paint, Ceilings, Plaster)',
    'K': 'Accessories (Partitions, Signage, Planting)',
    'L': 'Equipment (Specialist)',
    'M': 'Furnishings (Loose Furniture, Street Furniture)',
    'N': 'Special Construction (Water Features)',
    'P': 'Conveying (Lifts, Escalators, Travelators)',
    'Q': 'Mechanical (HVAC, Drainage, Plumbing, Fire)',
    'R': 'Electrical (LV, Lighting, Distribution, ELV)',
}

# ─── AI system prompt ─────────────────────────────────────────────────────────
AI_SYSTEM = textwrap.dedent("""
You are an expert POMI (Property & Occupational Measurement Index) BQ coder for construction projects.
Your job is to assign the correct 7-digit POMI code and NRM cost plan code to each BQ description.

POMI Code format: [Section letter][L1 2-digit][L2 2-digit][L3 2-digit]
Example: J030100 = Section J (Finishes), L1=03 (Floor Finishes), L2=01 (Tiles), L3=00

POMI Sections:
A=General Requirements, B=Site Work, C=Concrete, D=Masonry, E=Metalwork,
F=Woodwork/Joinery, G=Thermal/Moisture, H=Doors&Windows, J=Finishes,
K=Accessories, L=Equipment, M=Furnishings, N=Special Construction,
P=Conveying, Q=Mechanical, R=Electrical

NRM Cost Plan Codes (most common):
1.01=Substructure, 2.01=Frame, 2.02=Upper Floors, 2.05=External Walls,
2.06=Windows & External Doors, 2.07=Internal Walls, 2.08=Internal Doors,
3.01=Wall/Floor/Ceiling Finishes, 4.01=FF&E, 5.01=Sanitary Appliances,
5.03=Disposal, 5.04=Water Installations, 5.06=Space Heating & Air Treatment,
5.07=Ventilation, 5.08=Electrical Installations, 5.10=Lift & Conveyor,
5.11=Fire & Lightning Protection, 5.12=Communication & Security,
7.01=Minor Demolition & Alteration, 8.01=External Works, 9.01=Preliminaries

Respond ONLY with a JSON array — one object per item — no preamble, no markdown.
Each object must have exactly these keys:
  "idx"       : integer (the index number from the input)
  "pomi_code" : string  (7-char code e.g. "J030100")
  "nrm_code"  : string  (e.g. "3.01")
  "nrm_desc"  : string  (short description e.g. "Finishes – Floor Tile")
  "measurement": string (e.g. "Area (m²)")
  "confidence": integer (50–99)
  "reasoning" : string  (one sentence explaining the code choice)
""").strip()


class BQCodingEngine:
    """
    Three-stage POMI BQ coding engine.

    Parameters
    ----------
    pomi_path : str
        Path to POMI_CODING_FINAL.xlsx  (used for fuzzy fallback lookup)
    api_key : str, optional
        Anthropic API key.  If None, reads from ANTHROPIC_API_KEY env var.
    """

    # Haiku 4.5 pricing per million tokens
    _PRICE_IN  = 0.80   # USD per 1M input tokens
    _PRICE_OUT = 4.00   # USD per 1M output tokens

    def __init__(self, pomi_path: str = 'POMI_CODING_FINAL.xlsx',
                 api_key: Optional[str] = None):
        self.api_key        = api_key or os.environ.get('ANTHROPIC_API_KEY', '')
        self.total_in_tok   = 0
        self.total_out_tok  = 0
        self._all_rules    = RULES + LEARNED_RULES
        self._load_lookup(pomi_path)
        self.new_rules     = []
        self._existing_kw  = {tuple(sorted(kws)) for kws, *_ in self._all_rules}
        print(f"  Engine ready — {len(self._all_rules)} rules | "
              f"{len(self.lookup_rows)} POMI clauses | "
              f"{len(self._section_names)} sections | "
              f"AI {'✓' if self.api_key else '✗ (no API key)'}")

    # ── Lookup loader ─────────────────────────────────────────────────────────
    def _load_lookup(self, path: str):
        self._section_names = {}
        self._l1_names      = {}
        self.lookup_rows = []
        if not _OPENPYXL_OK or not os.path.exists(path):
            print(f"  ⚠  POMI reference not found: {path}  — fuzzy fallback disabled")
            return
        wb  = load_workbook(path)
        ws  = wb['LOOKUP_DATA']
        for r in range(2, ws.max_row + 1):
            row = [ws.cell(r, c).value for c in range(1, 10)]
            if row[0]:
                self.lookup_rows.append(
                    tuple(str(v) if v is not None else '' for v in row))
        # Build a compact pomi_desc dict
        self.pomi_desc = {r[4]: r[5] for r in self.lookup_rows}

        # Build hierarchy dicts
        self._section_names = {}
        self._l1_names      = {}
        for r in self.lookup_rows:
            sec, l1, l2, l3 = r[0], r[1], r[2], r[3]
            desc = r[5]
            l1i  = int(l1) if str(l1).isdigit() else 0
            l2i  = int(l2) if str(l2).isdigit() else 0
            l3i  = int(l3) if str(l3).isdigit() else 0
            if l1i == 0 and l2i == 0 and l3i == 0:
                name = desc.replace(f'SECTION {sec} - ', '').title()
                self._section_names[sec] = name
            elif l2i == 0 and l3i == 0 and l1i != 0:
                self._l1_names[(sec, l1i)] = desc

    def get_hierarchy(self, pomi_code: str) -> dict:
        """Return hierarchy dict for a given POMI code."""
        code = str(pomi_code or '').strip().upper()
        if len(code) < 7:
            return {}
        sec    = code[0]
        l1_str = code[1:3]
        l1_num = int(l1_str) if l1_str.isdigit() else 0
        return {
            'section_name': self._section_names.get(sec, f'Section {sec}'),
            'code1':        sec,
            'code2':        code[0:3],
            'code3':        code[0:5],
            'sub_section':  self._l1_names.get((sec, l1_num), ''),
        }

    # ── Stage 1: keyword rules ────────────────────────────────────────────────
    def _rule_match(self, desc: str) -> Optional[dict]:
        d = desc.lower()
        for kws, pomi, nrm_c, nrm_d, meas, conf in self._all_rules:
            if all(kw in d for kw in kws):
                return {'stage': 'rule', 'pomi_code': pomi,
                        'section': pomi[0], 'nrm_code': nrm_c,
                        'nrm_desc': nrm_d, 'measurement': meas,
                        'confidence': conf, 'reasoning': f'Matched rule keywords: {kws}'}
        return None

    # ── Stage 2: fuzzy fallback ───────────────────────────────────────────────
    def _get_hint(self, desc: str) -> Optional[str]:
        d = desc.lower()
        scores = {s: sum(1 for kw in kws if kw in d)
                  for s, kws in HINT_KW.items()}
        best = max(scores, key=scores.get)
        return best if scores[best] > 0 else None

    def _fuzzy_match(self, desc: str) -> Optional[dict]:
        if not _FUZZY_OK or not self.lookup_rows:
            return None
        d    = desc.lower().strip()
        hint = self._get_hint(desc)
        best_score, best_row = 0, None
        for row in self.lookup_rows:
            sec, l1, l2, l3, code, row_desc, nrm_c, nrm_d, meas = row
            combined = (fuzz.token_set_ratio(d, row_desc.lower()) * 0.5 +
                        fuzz.partial_ratio(d, row_desc.lower())   * 0.3 +
                        fuzz.WRatio(d, row_desc.lower())           * 0.2)
            if hint and sec == hint:
                combined = min(100, combined + 15)
            if combined > best_score:
                best_score, best_row = combined, row
        if not best_row:
            return None
        sec, l1, l2, l3, code, row_desc, nrm_c, nrm_d, meas = best_row
        conf = round(min(79, best_score))
        return {'stage': 'fuzzy', 'pomi_code': code,
                'section': sec, 'nrm_code': nrm_c,
                'nrm_desc': nrm_d, 'measurement': meas,
                'confidence': conf,
                'reasoning': f'Fuzzy match ({conf}%) against: "{row_desc[:60]}"'}

    # ── Stage 3: AI batch ─────────────────────────────────────────────────────
    def _ai_batch(self, items: list[tuple[int, str]],
                  batch_context: str = '') -> dict[int, dict]:
        """
        Send a batch of (idx, description) to Claude API.
        Returns dict of idx → result.
        """
        if not self.api_key:
            return {}
        try:
            import urllib.request, urllib.error
        except ImportError:
            return {}

        # Remap to 1-based sequential indices for the prompt
        idx_map  = {i + 1: orig_idx for i, (orig_idx, _) in enumerate(items)}
        numbered = '\n'.join(f'{i+1}. {desc}' for i, (_, desc) in enumerate(items))
        header   = (f"Project context: {batch_context}\n\n" if batch_context else '')
        prompt   = (f"{header}Code the following {len(items)} BQ items.\n"
                    f"Return a JSON array with one object per item.\n\n"
                    f"{numbered}")

        body = json.dumps({
            'model':      'claude-haiku-4-5-20251001',
            'max_tokens': max(4000, len(items) * 300),
            'system':     AI_SYSTEM,
            'messages':   [{'role': 'user', 'content': prompt}]
        }).encode()

        req = urllib.request.Request(
            'https://api.anthropic.com/v1/messages',
            data    = body,
            headers = {
                'Content-Type':      'application/json',
                'x-api-key':         self.api_key,
                'anthropic-version': '2023-06-01',
            })

        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read())
        except Exception as e:
            print(f"    ⚠  AI API error: {e}")
            return {}

        usage = data.get('usage', {})
        self.total_in_tok  += usage.get('input_tokens',  0)
        self.total_out_tok += usage.get('output_tokens', 0)

        raw = ''
        for block in data.get('content', []):
            if block.get('type') == 'text':
                raw += block['text']

        # Strip markdown fences if present
        raw = re.sub(r'```json\s*', '', raw)
        raw = re.sub(r'```\s*',     '', raw)

        try:
            parsed = json.loads(raw.strip())
        except Exception:
            print(f"    ⚠  AI returned invalid JSON")
            return {}

        results = {}
        for obj in parsed:
            prompt_idx = obj.get('idx')
            pomi = str(obj.get('pomi_code', '')).strip().upper()
            if not prompt_idx or not pomi:
                continue
            orig_idx = idx_map.get(int(prompt_idx))
            if orig_idx is None:
                continue
            sec  = pomi[0] if pomi else '?'
            results[orig_idx] = {
                'stage':       'ai',
                'pomi_code':   pomi,
                'section':     sec,
                'nrm_code':    str(obj.get('nrm_code',    '')),
                'nrm_desc':    str(obj.get('nrm_desc',    '')),
                'measurement': str(obj.get('measurement', '')),
                'confidence':  int(obj.get('confidence',  70)),
                'reasoning':   str(obj.get('reasoning',   'AI assigned')),
            }
        return results

    # ── Auto-learning ─────────────────────────────────────────────────────────
    def _extract_keywords(self, desc: str) -> list:
        """Extract 1–3 distinctive keywords from a BQ description."""
        d = desc.lower().strip()
        # Priority 1: type/ref codes
        type_codes = re.findall(r'(?:type|ref\.?)\s+[\w\-\.]+', d)
        if type_codes:
            return [type_codes[0].strip()]
        # Priority 2: dimension strings
        dims = re.findall(r'\d+\s*x\s*\d+\s*\w*|\d+mm\b', d)
        # Priority 3: strong nouns (strip stopwords)
        STOP = {
            'the','and','or','of','to','in','a','an','at','by','for','with',
            'on','off','no','is','are','not','from','into','per','as','be',
            'all','any','each','item','work','supply','fix','install','provide',
            'including','allow','note','generally','grade','class','shall',
            'set','out','put','get','has','have','been','above','below',
        }
        words = [w for w in re.findall(r'[a-z]{4,}', d) if w not in STOP]
        scored = sorted(set(words), key=lambda w: -len(w))
        keywords = []
        if dims:
            keywords.append(dims[0].replace(' ', ''))
        keywords.extend(scored[:3 - len(keywords)])
        return keywords[:3]

    def _learn_from_ai(self, desc: str, result: dict):
        """Convert high-confidence AI result into a new rule candidate."""
        if result.get('confidence', 0) < 85:
            return
        kws = self._extract_keywords(desc)
        if not kws:
            return
        kw_tuple = tuple(sorted(kws))
        if kw_tuple in self._existing_kw:
            return
        self._existing_kw.add(kw_tuple)
        self.new_rules.append({
            'keywords': list(kws),
            'pomi':     result['pomi_code'],
            'nrm_c':    result['nrm_code'],
            'nrm_d':    result['nrm_desc'],
            'meas':     result['measurement'],
            'conf':     min(90, result['confidence']),
            'source':   desc[:100].replace('\n', ' ').replace('\r', ''),
        })

    def save_new_rules(self, rules_path: str) -> int:
        """Append learned rules to pomi_rules.py. Returns count added."""
        if not self.new_rules:
            return 0
        from collections import defaultdict
        by_sec = defaultdict(list)
        for r in self.new_rules:
            by_sec[r['pomi'][0] if r['pomi'] else '?'].append(r)

        lines = []
        for sec in sorted(by_sec):
            lines.append(f'    # Section {sec}\n')
            for r in by_sec[sec]:
                lines.append(f'    # Source: {r["source"]}\n')
                lines.append(
                    f'    ({repr(r["keywords"])}, {repr(r["pomi"])}, '
                    f'{repr(r["nrm_c"])}, {repr(r["nrm_d"])}, '
                    f'{repr(r["meas"])}, {r["conf"]}),\n'
                )

        with open(rules_path, 'r') as f:
            content = f.read()
        # Insert before the closing ] of LEARNED_RULES (last ] in file)
        marker = '\nLEARNED_RULES = ['
        if marker not in content:
            return 0
        insert_pos = content.rfind(']')   # last ] = end of LEARNED_RULES
        if insert_pos == -1:
            return 0
        with open(rules_path, 'w') as f:
            f.write(content[:insert_pos] + '\n' + ''.join(lines) + content[insert_pos:])
        return len(self.new_rules)

    # ── Public: code a list of items ──────────────────────────────────────────
    def code_items(self,
                   items: list[str],
                   use_ai: bool = False,
                   batch_size: int = 10,
                   progress_cb=None,
                   contexts: list[str] = None,
                   batch_context: str = '') -> list[dict]:
        """
        Code a list of BQ description strings.

        Parameters
        ----------
        items       : list of description strings
        use_ai      : whether to send unmatched items to Claude API
        batch_size  : how many items per AI batch (1–50)
        progress_cb : optional callback(done, total, stage_counts)

        Returns
        -------
        list of dicts, one per input item, in same order.
        Each dict has keys:
          pomi_code, section, nrm_code, nrm_desc, measurement,
          confidence, stage ('rule'|'fuzzy'|'ai'|'unmatched'), reasoning
        """
        results  = [None] * len(items)
        ai_queue = []   # (original_idx, desc)
        counts   = {'rule': 0, 'fuzzy': 0, 'ai': 0, 'unmatched': 0}

        # Stage 1 & 2 — run synchronously
        for i, desc in enumerate(items):
            if not desc or not str(desc).strip():
                results[i] = _empty()
                counts['unmatched'] += 1
                continue

            # Build enriched description for AI (original desc for rules/fuzzy)
            enriched = str(desc)
            if contexts and i < len(contexts) and contexts[i]:
                enriched = f"[{contexts[i]}] {desc}"

            r = self._rule_match(str(desc))
            if r:
                results[i] = r
                counts['rule'] += 1
            elif use_ai:
                ai_queue.append((i, enriched))   # defer to AI with context
            else:
                r2 = self._fuzzy_match(str(desc))
                if r2:
                    results[i] = r2
                    counts['fuzzy'] += 1
                else:
                    results[i] = _empty()
                    counts['unmatched'] += 1

            if progress_cb:
                progress_cb(i + 1, len(items), counts)

        # Stage 3 — AI batches (only items that didn't match rules)
        if use_ai and ai_queue:
            print(f"\n  ── AI stage: {len(ai_queue)} items in batches of {batch_size} ──")
            for batch_start in range(0, len(ai_queue), batch_size):
                batch = ai_queue[batch_start: batch_start + batch_size]
                batch_num = batch_start // batch_size + 1
                total_batches = (len(ai_queue) + batch_size - 1) // batch_size
                print(f"    Batch {batch_num}/{total_batches}  "
                      f"({len(batch)} items) ... ", end='', flush=True)

                ai_results = self._ai_batch(batch, batch_context=batch_context)
                t0 = time.time()

                for orig_idx, desc in batch:
                    r_ai = ai_results.get(orig_idx)
                    if r_ai and r_ai['confidence'] >= 70:
                        results[orig_idx] = r_ai
                        counts['ai'] += 1
                        self._learn_from_ai(desc, r_ai)
                    else:
                        # AI failed → fall back to fuzzy
                        r_fz = self._fuzzy_match(desc)
                        if r_fz:
                            results[orig_idx] = r_fz
                            counts['fuzzy'] += 1
                        else:
                            results[orig_idx] = _empty()
                            counts['unmatched'] += 1

                elapsed = time.time() - t0
                print(f"done  ({elapsed:.1f}s)")

                if progress_cb:
                    progress_cb(len(items), len(items), counts)

                # Polite rate-limit pause between batches
                if batch_start + batch_size < len(ai_queue):
                    time.sleep(0.5)

        # Replace remaining Nones (items skipped before AI)
        for i, r in enumerate(results):
            if r is None:
                results[i] = _empty()
                counts['unmatched'] += 1

        total = len(items)
        print(f"\n  Coding complete:")
        print(f"    Rules  ✓  {counts['rule']:4d} / {total}  ({counts['rule']*100//total if total else 0}%)")
        if counts['fuzzy']:
            print(f"    Fuzzy  ⚠  {counts['fuzzy']:4d} / {total}  ({counts['fuzzy']*100//total if total else 0}%)")
        if counts['ai']:
            print(f"    AI     ✓  {counts['ai']:4d} / {total}  ({counts['ai']*100//total if total else 0}%)")
        if counts['unmatched']:
            print(f"    None   —  {counts['unmatched']:4d} / {total}")

        return results


# ── Helper ────────────────────────────────────────────────────────────────────
def _empty() -> dict:
    return {'stage': 'unmatched', 'pomi_code': '', 'section': '',
            'nrm_code': '', 'nrm_desc': '', 'measurement': '',
            'confidence': 0, 'reasoning': ''}
