#!/usr/bin/env python3
"""
pomi_coder_app.py
─────────────────
Universal POMI BQ Auto-Coder

Reads ANY Excel BQ file, detects all sheets and items automatically,
codes every item through the 3-stage pipeline (Rules → Fuzzy → AI),
and writes a fully formatted output workbook.

USAGE:
  python pomi_coder_app.py  POMI_CODING_FINAL.xlsx  YourBQ.xlsx
  python pomi_coder_app.py  POMI_CODING_FINAL.xlsx  YourBQ.xlsx  --ai
  python pomi_coder_app.py  POMI_CODING_FINAL.xlsx  YourBQ.xlsx  --ai --batch 10
  python pomi_coder_app.py  POMI_CODING_FINAL.xlsx  YourBQ.xlsx  --out MyOutput.xlsx
  python pomi_coder_app.py  POMI_CODING_FINAL.xlsx  Data/AKAM/ --ai \
      --country UAE --city Dubai --asset AKAM --project "AKAM Mall Refurbishment" \
      --type Commercial --employer "Majid Al Futtaim" --contractor "ABC Contracting LLC" \
      --contract-type "Lump Sum" --tender-date "21/02/2024"

OPTIONS:
  --ai             Enable AI coding for items that rules don't match
  --batch N        AI batch size — items per API call (default: 10)
  --out FILE       Output filename (default: <input>_POMI_Coded.xlsx)
  --api-key KEY    Anthropic API key (or set ANTHROPIC_API_KEY env var)
  --sheets S1 S2   Only process specific sheets (default: all)
  --skip-headers   Skip rows with no item reference AND no amount
  --country        Country (e.g. UAE)
  --city           City (e.g. Dubai)
  --asset          Asset name (e.g. AKAM)
  --project        Project / villa name
  --type           Asset type (e.g. Commercial)
  --employer       Employer name
  --contractor     Contractor name
  --status         Project status
  --contract-type  Contract type (e.g. Lump Sum)
  --tender-date    Tender date (e.g. 21/02/2024)
  --award-date     Award date
  --currency       Currency code (default: auto-detect, fallback AED)

REQUIREMENTS:
  pip install openpyxl rapidfuzz
  (AI mode also needs: internet + Anthropic API key)
"""

import sys, os, re, argparse
from datetime import datetime
from openpyxl import load_workbook, Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

from pomi_coder_engine import BQCodingEngine

# ── Colour palette ────────────────────────────────────────────────────────────
SECTION_COLORS = {
    'A': ('FF1B2A4A', 'FFD6E4F0'),
    'B': ('FF1A5276', 'FFD6EAF8'),
    'C': ('FF7D6608', 'FFFFF3CD'),
    'D': ('FF4A235A', 'FFF5EEF8'),
    'E': ('FF1A6B75', 'FFD1F2EB'),
    'F': ('FF6E2F0A', 'FFFDE8D8'),
    'G': ('FF145A32', 'FFD5F5E3'),
    'H': ('FF1F618D', 'FFD4E6F1'),
    'J': ('FF943126', 'FFFDEDEC'),
    'K': ('FF7D3C98', 'FFF4ECF7'),
    'L': ('FF1B7A4E', 'FFD5F5E3'),
    'M': ('FF21618C', 'FFD4E6F1'),
    'N': ('FF0E6655', 'FFD0ECE7'),
    'P': ('FF1B2631', 'FFD5D8DC'),
    'Q': ('FF117A65', 'FFD0ECE7'),
    'R': ('FF7B241C', 'FFFDEDEC'),
}
DEFAULT_DARK  = 'FF2C3E50'
DEFAULT_LIGHT = 'FFF2F2F2'
NAVY   = 'FF1B2A4A'
ORANGE = 'FFFFC000'

def sol(h):  return PatternFill('solid', fgColor=h)
def fnt(bold=False, size=9, col='FF000000', italic=False):
    return Font(name='Arial', bold=bold, size=size, color=col, italic=italic)
def aln(h='left', v='center', wrap=False):
    return Alignment(horizontal=h, vertical=v, wrap_text=wrap)
def bdr(col='FFD0D0D0'):
    s = Side(style='thin', color=col)
    return Border(left=s, right=s, top=s, bottom=s)


# ── Excel reader — smart column detection ─────────────────────────────────────
def detect_columns(ws):
    """
    Scan the first 10 rows to detect which columns hold:
    item_ref, description, qty, unit, rate, amount
    Returns a dict of col_name → column_index (1-based)
    """
    PATTERNS = {
        'item_ref':    re.compile(r'item|ref|no\.?$|^#$', re.I),
        'description': re.compile(r'descri|particular|item detail', re.I),
        'qty':         re.compile(r'^qty$|^quantity$|^q$', re.I),
        'unit':        re.compile(r'^unit$|^u$|^uom$', re.I),
        'rate':        re.compile(r'^rate$|^unit.?rate$|^price$', re.I),
        'amount':      re.compile(r'^amount|^total$|^value$|^aed$|^sum$', re.I),
    }
    cols = {}
    for row in ws.iter_rows(min_row=1, max_row=10):
        for cell in row:
            val = str(cell.value or '').strip().replace('\n', ' ').replace('\r', '')
            for name, pat in PATTERNS.items():
                if name not in cols and pat.search(val):
                    cols[name] = cell.column
        if len(cols) >= 4:
            break

    # Fallback: assume standard layout A=ref B=desc C=qty D=unit E=rate F=amount
    defaults = {'item_ref': 1, 'description': 2, 'qty': 3,
                'unit': 4, 'rate': 5, 'amount': 6}
    for k, v in defaults.items():
        if k not in cols:
            cols[k] = v
    return cols


def read_sheet_items(ws, col_map):
    """
    Read all rows from a sheet.
    Returns list of dicts with keys: src_row, item_ref, description,
    qty, unit, rate, amount, is_header, is_collection, is_blank
    """
    items = []
    for r in range(1, ws.max_row + 1):
        def cell(col_name):
            ci = col_map.get(col_name, 0)
            return ws.cell(r, ci).value if ci else None

        item_ref = cell('item_ref')
        desc     = cell('description')
        qty      = cell('qty')
        unit     = cell('unit')
        rate     = cell('rate')
        amount   = cell('amount')

        # Completely blank row
        if all(v is None for v in [item_ref, desc, qty, unit, rate, amount]):
            items.append({'src_row': r, 'item_ref': None, 'description': None,
                          'qty': None, 'unit': None, 'rate': None, 'amount': None,
                          'is_blank': True, 'is_header': False, 'is_collection': False})
            continue

        # Skip column header rows (e.g. "Item" | "Description" | "Quantity"...)
        _HEADER_KEYWORDS = re.compile(
            r'^(item|ref|no\.?|description|particulars|qty|quantity|unit|rate|amount|total|aed)$',
            re.I)
        if (item_ref is not None and desc is not None
                and _HEADER_KEYWORDS.match(str(item_ref).strip())
                and _HEADER_KEYWORDS.match(str(desc).strip())):
            continue

        # Skip description-only rows starting with '.'
        if desc and str(desc).startswith('.'):
            continue

        desc_str = str(desc or '').strip()

        is_collection = any(x in desc_str for x in
                            ['To Collection', 'Carried To', 'COLLECTION',
                             'Brought Forward', 'Page Total', 'Total to'])
        is_header = (item_ref is None and desc is not None
                     and qty is None and amount is None
                     and not is_collection)

        items.append({
            'src_row':     r,
            'item_ref':    item_ref,
            'description': desc,
            'qty':         qty,
            'unit':        unit,
            'rate':        rate,
            'amount':      amount,
            'is_blank':    False,
            'is_header':   is_header,
            'is_collection': is_collection,
        })
    return items


# ── Output workbook builder ───────────────────────────────────────────────────
DATA_COLS = [
    ('A', 'Row',          5),
    ('B', 'Item Ref',     9),
    ('C', 'Description',  52),
    ('D', 'Qty',          8),
    ('E', 'Unit',         7),
    ('F', 'Rate\nAED',    12),
    ('G', 'Amount\nAED',  14),
    ('H', 'POMI\nSec',    7),
    ('I', 'POMI Code',    11),
    ('J', 'NRM',          8),
    ('K', 'NRM Description', 26),
    ('L', 'Measurement',  16),
    ('M', 'Conf%',        7),
    ('N', 'Stage',        8),
    ('O', 'Flag',         5),
]

FLAG_COLS = [
    ('A', 'Source Sheet', 22), ('B', 'Row',     6),
    ('C', 'Item Ref',      9), ('D', 'Description', 54),
    ('E', 'Qty',           8), ('F', 'Unit',    7),
    ('G', 'Rate AED',     12), ('H', 'Amount AED', 14),
    ('I', 'POMI Code',    11), ('J', 'NRM',     8),
    ('K', 'NRM Description', 26), ('L', 'Measurement', 16),
    ('M', 'Conf%',         7), ('N', 'Stage',   8),
    ('O', 'Reasoning',    42),
]


def write_data_sheet(wb_out, sheet_name, items, results, project_title):
    """Write one coded data sheet to the output workbook."""
    ws = wb_out.create_sheet(title=sheet_name[:31])
    ws.sheet_view.showGridLines = False
    ws.freeze_panes = 'A4'
    ws.sheet_view.zoomScale = 80

    for cl, _, w in DATA_COLS:
        ws.column_dimensions[cl].width = w

    # Pick header colour based on dominant section
    sec_counts = {}
    for r in results:
        if r and r.get('section'):
            sec_counts[r['section']] = sec_counts.get(r['section'], 0) + 1
    dom_sec = max(sec_counts, key=sec_counts.get) if sec_counts else ''
    dark, light = SECTION_COLORS.get(dom_sec, (DEFAULT_DARK, DEFAULT_LIGHT))

    # Title row
    ws.merge_cells('A1:O1')
    c = ws['A1']
    c.value     = f'{project_title}  ·  {sheet_name}'
    c.font      = Font(name='Arial', bold=True, size=11, color='FFFFFFFF')
    c.fill      = sol(dark)
    c.alignment = aln('center', 'center')
    ws.row_dimensions[1].height = 26

    # Sub-title
    ws.merge_cells('A2:O2')
    c = ws['A2']
    c.value = ('A–G = original bill  ·  H–O = POMI + NRM coding  ·  '
               '✓ rule/AI ≥85%  ·  ⚠ fuzzy/AI <85% = review')
    c.font      = Font(name='Arial', size=9, color='FF1B2A4A', italic=True)
    c.fill      = sol('FFD6E4F0')
    c.alignment = aln('left', 'center')
    ws.row_dimensions[2].height = 14

    # Header row
    for ci, (_, hdr, _) in enumerate(DATA_COLS, 1):
        c = ws.cell(3, ci)
        c.value     = hdr
        c.font      = Font(name='Arial', bold=True, size=9, color='FFFFFFFF')
        c.fill      = sol(dark)
        c.alignment = aln('center', 'center', True)
        c.border    = bdr()
    ws.row_dimensions[3].height = 28

    out_r  = 4
    coded  = flagged = 0
    ri     = 0   # result index (only priced items get a result)

    for item in items:
        # Skip blank rows entirely — don't write them to output
        if item.get('is_blank'):
            continue

        desc   = item['description']
        is_col = item['is_collection']
        is_hdr = item['is_header']

        # Context/section header rows → write as a full-width merged info bar
        if is_hdr:
            desc_str = str(desc or '').strip()
            if not desc_str:
                continue
            ws.merge_cells(f'A{out_r}:O{out_r}')
            c = ws.cell(out_r, 1)
            c.value     = f'  ▸  {desc_str}'
            # Section titles (ALL CAPS) get a darker band; context rows get subtle
            is_section = desc_str.isupper() or (desc_str == desc_str.upper() and len(desc_str) > 6)
            if is_section:
                c.fill = sol('FFD6E4F0')
                c.font = Font(name='Arial', bold=True, size=9, color='FF1B2A4A')
            else:
                c.fill = sol('FFFFFBE6')
                c.font = Font(name='Arial', bold=False, size=8, color='FF7D6608', italic=True)
            c.alignment = aln('left', 'center')
            ws.row_dimensions[out_r].height = 13
            out_r += 1
            continue

        # Row fill for data rows
        if is_col:
            rf = sol(ORANGE)
            tf = fnt(bold=True, size=9, col='FF1B2A4A')
        elif out_r % 2 == 0:
            rf = sol('FFFFFFFF')
            tf = fnt(size=9)
        else:
            rf = sol('FFF8F9FA')
            tf = fnt(size=9)

        # Write original columns
        vals = [item['src_row'], item['item_ref'], desc,
                item['qty'], item['unit'], item['rate'], item['amount']]
        for ci, val in enumerate(vals, 1):
            c = ws.cell(out_r, ci)
            c.value     = val
            c.fill      = rf
            c.font      = tf
            c.alignment = (aln('center', 'center') if ci in [1, 2, 4, 5]
                           else aln('left', 'top', ci == 3))
            c.border    = bdr()
            if ci in [6, 7] and isinstance(val, (int, float)):
                c.number_format = '#,##0.00'

        # Write coding columns
        is_priced = (item['item_ref'] is not None and desc is not None
                     and not is_col)
        result = None
        if is_priced and ri < len(results):
            result = results[ri]
            ri += 1

        if result and result.get('pomi_code'):
            coded += 1
            conf  = result['confidence']
            stage = result['stage']
            flag  = '✓' if conf >= 85 else '⚠'
            if conf < 85:
                flagged += 1
            cf    = sol('FFD5F5E3') if conf >= 85 else sol('FFFDE8D8')
            fc    = 'FF1E8449'     if conf >= 85 else 'FFB03A2E'

            stage_lbl = {'rule': 'Rule', 'fuzzy': 'Fuzzy',
                         'ai': 'AI', 'unmatched': '—'}.get(stage, stage)

            for i, val in enumerate([result['section'], result['pomi_code'],
                                      result['nrm_code'], result['nrm_desc'],
                                      result['measurement'], conf,
                                      stage_lbl, flag], 8):
                c = ws.cell(out_r, i)
                c.value     = val
                c.border    = bdr()
                c.alignment = aln('center', 'center')
                if i in [13, 15]:   # conf, flag
                    c.font = fnt(bold=True, size=9, col=fc)
                    c.fill = cf
                elif i == 8:        # section
                    sec_d, sec_l = SECTION_COLORS.get(result['section'],
                                                       (DEFAULT_DARK, DEFAULT_LIGHT))
                    c.font = fnt(bold=True, size=9, col='FF' + sec_d[2:])
                    c.fill = sol(sec_l)
                elif i == 9:        # pomi code
                    c.font = fnt(bold=True, size=9, col='FF1B2A4A')
                    c.fill = sol('FFD6E4F0')
                else:
                    c.font = fnt(size=9)
                    c.fill = sol('FFE8F4FB')
        else:
            for i in range(8, 16):
                c = ws.cell(out_r, i)
                c.fill   = sol('FFF8F9FA')
                c.border = bdr()

        dl = len(str(desc)) if desc else 0
        ws.row_dimensions[out_r].height = max(14, min(60, dl // 6))
        out_r += 1

    # Footer
    out_r += 1
    ws.merge_cells(f'A{out_r}:O{out_r}')
    c = ws.cell(out_r, 1)
    pct = round((coded - flagged) / coded * 100) if coded else 0
    c.value     = (f'Items coded: {coded}  ·  Auto ✓: {coded-flagged}  ·  '
                   f'Flagged ⚠: {flagged}  ·  Auto rate: {pct}%')
    c.font      = Font(name='Arial', bold=True, size=9, color='FFFFFFFF')
    c.fill      = sol(dark)
    c.alignment = aln('left', 'center')
    ws.row_dimensions[out_r].height = 16

    return coded, flagged


def write_flagged_sheet(wb_out, all_flagged):
    ws = wb_out.create_sheet('⚠ FLAGGED FOR REVIEW')
    ws.sheet_view.showGridLines = False
    ws.freeze_panes = 'A4'
    ws.sheet_view.zoomScale = 80

    for cl, _, w in FLAG_COLS:
        ws.column_dimensions[cl].width = w

    ws.merge_cells('A1:O1')
    c = ws['A1']
    c.value     = (f'FLAGGED ITEMS  ·  {len(all_flagged)} items below 85% confidence  ·  '
                   f'Review and correct POMI Code (Col I) where needed')
    c.font      = Font(name='Arial', bold=True, size=11, color='FFFFFFFF')
    c.fill      = sol('FF922B21')
    c.alignment = aln('center', 'center')
    ws.row_dimensions[1].height = 26

    ws.merge_cells('A2:O2')
    c = ws['A2']
    c.value = 'AI/fuzzy suggestion is pre-filled.  Override Col I (POMI Code) where incorrect.'
    c.font      = Font(name='Arial', size=9, color='FF922B21', italic=True)
    c.fill      = sol('FFFCE4D6')
    c.alignment = aln('left', 'center')
    ws.row_dimensions[2].height = 14

    for ci, (_, hdr, _) in enumerate(FLAG_COLS, 1):
        c = ws.cell(3, ci)
        c.value     = hdr
        c.font      = Font(name='Arial', bold=True, size=9, color='FFFFFFFF')
        c.fill      = sol('FF922B21')
        c.alignment = aln('center', 'center', True)
        c.border    = bdr()
    ws.row_dimensions[3].height = 26

    for fi, row in enumerate(all_flagged, 4):
        r    = row['result']
        rf   = sol('FFFCE4D6') if fi % 2 == 0 else sol('FFFDF2F2')
        vals = [row['sheet'], row['src_row'], row['item_ref'], row['desc'],
                row['qty'], row['unit'], row['rate'], row['amount'],
                r['pomi_code'], r['nrm_code'], r['nrm_desc'],
                r['measurement'], r['confidence'], r['stage'],
                r.get('reasoning', '')]
        for ci, val in enumerate(vals, 1):
            c = ws.cell(fi, ci)
            c.value     = val
            c.fill      = rf
            c.font      = fnt(bold=(ci in [1, 9]), size=9,
                              col='FF922B21' if ci in [9, 13] else 'FF000000')
            c.alignment = (aln('center', 'center') if ci in [2, 3, 5, 6, 9, 10, 13, 14]
                           else aln('left', 'top', ci in [4, 11, 15]))
            c.border    = bdr()
            if ci in [7, 8] and isinstance(val, (int, float)):
                c.number_format = '#,##0.00'
        ws.row_dimensions[fi].height = max(14, min(60, len(str(row['desc'])) // 6))


def write_summary_sheet(wb_out, sheet_totals, project_title, args_info):
    ws = wb_out.create_sheet('SUMMARY', 0)
    ws.sheet_view.showGridLines = False

    col_ws = [('A', 26), ('B', 32), ('C', 8), ('D', 10),
              ('E', 10), ('F', 10), ('G', 10), ('H', 10)]
    for cl, w in col_ws:
        ws.column_dimensions[cl].width = w

    ws.merge_cells('A1:H1')
    c = ws['A1']
    c.value     = f'POMI BQ CODING SUMMARY  ·  {project_title}'
    c.font      = Font(name='Arial', bold=True, size=14, color='FFFFFFFF')
    c.fill      = sol(NAVY)
    c.alignment = aln('center', 'center')
    ws.row_dimensions[1].height = 32

    ws.merge_cells('A2:H2')
    c = ws['A2']
    c.value = (f'Generated: {datetime.now().strftime("%Y-%m-%d %H:%M")}  ·  '
               f'{args_info}')
    c.font      = Font(name='Arial', size=9, color='FF566573', italic=True)
    c.fill      = sol('FFF8F9FA')
    c.alignment = aln('left', 'center')
    ws.row_dimensions[2].height = 16
    ws.row_dimensions[3].height = 8

    hdrs = ['Sheet', 'Description', 'Rows', 'Coded', '✓ Rule',
            '~ Fuzzy', '✓ AI', '⚠ Review']
    for ci, h in enumerate(hdrs, 1):
        c = ws.cell(4, ci)
        c.value     = h
        c.font      = Font(name='Arial', bold=True, size=9, color='FFFFFFFF')
        c.fill      = sol(NAVY)
        c.alignment = aln('center', 'center')
        c.border    = bdr()
    ws.row_dimensions[4].height = 18

    tr = tc = trule = tfuzzy = tai = tflag = 0
    for ri, (sname, rows, coded, rule_n, fuzzy_n, ai_n, flag_n) in enumerate(sheet_totals, 5):
        rf = sol('FFF8F9FA') if ri % 2 == 0 else sol('FFFFFFFF')
        for ci, val in enumerate([sname, '', rows, coded,
                                   rule_n, fuzzy_n, ai_n, flag_n], 1):
            c = ws.cell(ri, ci)
            c.value     = val
            c.fill      = rf
            c.font      = fnt(bold=(ci == 1), size=9)
            c.alignment = aln('center' if ci > 2 else 'left', 'center')
            c.border    = bdr()
        ws.row_dimensions[ri].height = 15
        tr += rows; tc += coded; trule += rule_n
        tfuzzy += fuzzy_n; tai += ai_n; tflag += flag_n

    tot_r = 5 + len(sheet_totals) + 1
    auto_pct = round((trule + tai) / tc * 100) if tc else 0
    ws.merge_cells(f'A{tot_r}:H{tot_r}')
    c = ws.cell(tot_r, 1)
    c.value     = (f'TOTAL  ·  {tr} rows  ·  {tc} coded  ·  '
                   f'{trule+tai} auto ✓ ({auto_pct}%)  ·  {tflag} flagged ⚠')
    c.font      = Font(name='Arial', bold=True, size=10, color='FFFFFFFF')
    c.fill      = sol('FFCA6F1E')
    c.alignment = aln('center', 'center')
    ws.row_dimensions[tot_r].height = 20


