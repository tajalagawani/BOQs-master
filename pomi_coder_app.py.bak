    # Manual / workflow
    (1,  'ACTION',            6),
    # Auto from filename
    (2,  'BATCH',            38),
    (3,  'REF',               7),
    # CLI params
    (4,  'Country',           9),
    (5,  'City',              9),
    (6,  'Asset',             9),
    (7,  'Project',          26),
    (8,  'Type',             13),
    (9,  'Employer',         22),
    (10, 'Contractor',       22),
    (11, 'Status',            9),
    (12, 'Tender Date',      12),
    (13, 'Award Date',       12),
    (14, 'Contract Type',    13),
    # POMI hierarchy (auto from code)
    (15, 'POMI Section',     24),
    (16, 'Code 1',            8),
    (17, 'Code 2',            8),
    (18, 'Code 3',            8),
    (19, 'POMI Sub Section', 30),
    # Original BQ data
    (20, 'Description',      52),
    (21, 'Qty',               8),
    (22, 'Unit',              7),
    (23, 'Currency',          9),
    (24, 'Rate',             12),
    (25, 'Amount',           14),
    # NRM coding
    (26, 'NRM',               8),
    (27, 'NRM Description',  26),
    (28, 'Measurement',      16),
    # QA
    (29, 'Conf%',             7),
    (30, 'Stage',             8),
    (31, 'Flag',              5),
]


def write_master_sheet(wb_out, all_master, project_title, meta=None):
    """
    Write a single consolidated sheet with every priced item from all sheets.
    all_master = list of dicts with keys:
      sheet, item_ref, description, qty, unit, rate, amount, result,
      batch, hier (hierarchy dict)
    meta = dict of project-level fields from CLI params
    """
    if meta is None:
        meta = {}

    ws = wb_out.create_sheet(title='MASTER BOQs', index=1)
    ws.sheet_view.showGridLines = False
    ws.freeze_panes = 'A4'
    ws.sheet_view.zoomScale = 75

    ncols = len(MASTER_COLS)
    last_col = get_column_letter(ncols)

    for ci, hdr, w in MASTER_COLS:
        ws.column_dimensions[get_column_letter(ci)].width = w

    # ── Title ──────────────────────────────────────────────────────────────────
    ws.merge_cells(f'A1:{last_col}1')
    c = ws['A1']
    proj_lbl = meta.get('project') or project_title
    c.value     = f'MASTER BOQs  ·  {proj_lbl}  ·  All Sheets Combined'
    c.font      = Font(name='Arial', bold=True, size=11, color='FFFFFFFF')
    c.fill      = sol(NAVY)
    c.alignment = aln('center', 'center')
    ws.row_dimensions[1].height = 26

    ws.merge_cells(f'A2:{last_col}2')
    c = ws['A2']
    c.value     = ('All priced items from every bill sheet in one table  ·  '
                   'Use filters to sort by Sheet / POMI Section / Stage')
    c.font      = Font(name='Arial', size=9, color='FF566573', italic=True)
    c.fill      = sol('FFF8F9FA')
    c.alignment = aln('left', 'center')
    ws.row_dimensions[2].height = 14

    # ── Header row ─────────────────────────────────────────────────────────────
    HDR_COLORS = {
        1:  'FF4A235A',   # ACTION — manual
        2:  'FF1A5276',   # BATCH
        3:  'FF1A5276',   # REF
        4:  'FF1B7A4E',   # Country
        5:  'FF1B7A4E',   # City
        6:  'FF1B7A4E',   # Asset
        7:  'FF1B7A4E',   # Project
        8:  'FF1B7A4E',   # Type
        9:  'FF566573',   # Employer
        10: 'FF566573',   # Contractor
        11: 'FF4A235A',   # Status — manual
        12: 'FF1A5276',   # Tender Date
        13: 'FF4A235A',   # Award Date — manual
        14: 'FF1A5276',   # Contract Type
        15: 'FF7D6608',   # POMI Section
        16: 'FF7D6608',   # Code 1
        17: 'FF7D6608',   # Code 2
        18: 'FF7D6608',   # Code 3
        19: 'FF7D6608',   # POMI Sub Section
        20: NAVY,         # Description
        21: NAVY,         # Qty
        22: NAVY,         # Unit
        23: 'FF117A65',   # Currency
        24: NAVY,         # Rate
        25: NAVY,         # Amount
        26: 'FF1A6B75',   # NRM
        27: 'FF1A6B75',   # NRM Description
        28: 'FF1A6B75',   # Measurement
        29: 'FF117A65',   # Conf%
        30: 'FF117A65',   # Stage
        31: 'FF117A65',   # Flag
    }
    for ci, hdr, _ in MASTER_COLS:
        c = ws.cell(3, ci)
        c.value     = hdr
        c.font      = Font(name='Arial', bold=True, size=8, color='FFFFFFFF')
        c.fill      = sol(HDR_COLORS.get(ci, NAVY))
        c.alignment = aln('center', 'center', True)
        c.border    = bdr()
    ws.row_dimensions[3].height = 36

    ws.auto_filter.ref = f'A3:{last_col}3'

    CENTER_COLS = {1,2,3,4,5,6,8,11,12,13,14,16,17,18,21,22,23,26,29,30,31}

    total_amount = 0

    for ri, item in enumerate(all_master, 4):
        r      = item['result']
        hier   = item.get('hier', {})
        rf     = sol('FFFFFFFF') if ri % 2 == 0 else sol('FFF8F9FA')
        amount = item['amount']
        if isinstance(amount, (int, float)):
            total_amount += amount

        conf  = r['confidence'] if r and r.get('pomi_code') else 0
        is_good = conf >= 85
        cf = sol('FFD5F5E3') if is_good else sol('FFFDE8D8')
        fc = 'FF1E8449'     if is_good else 'FFB03A2E'
        stage_lbl = ''
        flag = ''
        if r and r.get('pomi_code'):
            stage_lbl = {'rule': 'Rule', 'fuzzy': 'Fuzzy',
                         'ai': 'AI', 'unmatched': '—'}.get(r['stage'], r['stage'])
            flag = '✓' if conf >= 85 else '⚠'

        pomi_code = r['pomi_code'] if r else ''
        sec_letter = r['section']  if r else ''

        vals = {
            1:  '',                                                    # ACTION — manual
            2:  item.get('batch', ''),                                 # BATCH
            3:  item['item_ref'],                                      # REF
            4:  meta.get('country', ''),                               # Country
            5:  meta.get('city', ''),                                  # City
            6:  meta.get('asset', item.get('asset_fallback', '')),     # Asset
            7:  meta.get('project', ''),                               # Project
            8:  meta.get('type', ''),                                  # Type
            9:  meta.get('employer', ''),                              # Employer
            10: meta.get('contractor', ''),                            # Contractor
            11: meta.get('status', ''),                                # Status — manual
            12: meta.get('tender_date', ''),                           # Tender Date
            13: meta.get('award_date', ''),                            # Award Date — manual
            14: meta.get('contract_type', ''),                         # Contract Type
            15: f"{sec_letter} — {hier.get('section_name', '')}" if sec_letter else '',
            16: hier.get('code1', sec_letter),                         # Code 1
            17: hier.get('code2', ''),                                 # Code 2
            18: hier.get('code3', ''),                                 # Code 3
            19: hier.get('sub_section', ''),                           # POMI Sub Section
            20: item['description'],                                   # Description
            21: item['qty'],                                           # Qty
            22: item['unit'],                                          # Unit
            23: item.get('currency', meta.get('currency', 'AED')),     # Currency
            24: item['rate'],                                          # Rate
            25: amount,                                                # Amount
            26: r['nrm_code']    if r else '',                         # NRM
            27: r['nrm_desc']    if r else '',                         # NRM Description
            28: r['measurement'] if r else '',                         # Measurement
            29: conf             if r and r.get('pomi_code') else '',  # Conf%
            30: stage_lbl,                                             # Stage
            31: flag,                                                   # Flag
        }

        for ci, _, _ in MASTER_COLS:
            val = vals.get(ci, '')
            c   = ws.cell(ri, ci)
            c.value  = val
            c.border = bdr()

            if ci == 1:  # ACTION — manual grey
                c.font      = fnt(size=8, col='FF999999', italic=True)
                c.fill      = sol('FFF5F5F5')
                c.alignment = aln('center', 'center')
            elif ci in [11, 13]:  # Status, Award — manual grey
                c.font      = fnt(size=8, col='FF999999', italic=True)
                c.fill      = sol('FFF5F5F5')
                c.alignment = aln('center', 'center')
            elif ci == 2:  # BATCH
                c.font      = fnt(size=8, col='FF1A5276')
                c.fill      = sol('FFD6EAF8')
                c.alignment = aln('center', 'center')
            elif ci == 3:  # REF
                c.font      = fnt(bold=True, size=9, col='FF1A5276')
                c.fill      = sol('FFD6EAF8')
                c.alignment = aln('center', 'center')
            elif ci in range(4, 15):  # Meta cols
                c.font      = fnt(size=8)
                c.fill      = sol('FFE8F8F5')
                c.alignment = aln('center' if ci in CENTER_COLS else 'left', 'center')
            elif ci in range(15, 20):  # POMI hierarchy
                c.font      = fnt(bold=(ci in [15, 16]), size=8, col='FF7D6608')
                c.fill      = sol('FFFFF3CD')
                c.alignment = aln('center' if ci in CENTER_COLS else 'left', 'center')
            elif ci == 20:  # Description
                c.font      = fnt(size=9)
                c.fill      = rf
                c.alignment = aln('left', 'top', True)
            elif ci in [21, 22]:  # Qty, Unit
                c.font      = fnt(size=9)
                c.fill      = rf
                c.alignment = aln('center', 'center')
            elif ci == 23:  # Currency
                c.font      = fnt(bold=True, size=8, col='FF1B2A4A')
                c.fill      = sol('FFD6E4F0')
                c.alignment = aln('center', 'center')
            elif ci in [24, 25]:  # Rate, Amount
                c.font      = fnt(size=9)
                c.fill      = rf
                c.alignment = aln('right', 'center')
                if isinstance(val, (int, float)):
                    c.number_format = '#,##0.00'
            elif ci in [26, 27, 28]:  # NRM
                c.font      = fnt(size=8, col='FF1A6B75')
                c.fill      = sol('FFD1F2EB')
                c.alignment = aln('center' if ci == 26 else 'left', 'center')
            elif ci in [29, 30, 31]:  # Conf/Stage/Flag
                c.font      = fnt(bold=True, size=9, col=fc if r and r.get('pomi_code') else 'FF000000')
                c.fill      = cf if r and r.get('pomi_code') else sol('FFF8F9FA')
                c.alignment = aln('center', 'center')
            else:
                c.font      = fnt(size=9)
                c.fill      = rf
                c.alignment = aln('center' if ci in CENTER_COLS else 'left', 'center')

        dl = len(str(item['description'])) if item['description'] else 0
        ws.row_dimensions[ri].height = max(14, min(60, dl // 6))

    # ── Grand total row ────────────────────────────────────────────────────────
    tot_r = 4 + len(all_master) + 1
    ws.merge_cells(f'A{tot_r}:{get_column_letter(24)}{tot_r}')
    c = ws.cell(tot_r, 1)
    c.value     = f'GRAND TOTAL  ·  {len(all_master)} items'
    c.font      = Font(name='Arial', bold=True, size=10, color='FFFFFFFF')
    c.fill      = sol('FFCA6F1E')
    c.alignment = aln('right', 'center')
    ws.row_dimensions[tot_r].height = 20

    c = ws.cell(tot_r, 25)
    c.value         = total_amount
    c.number_format = '#,##0.00'
    c.font          = Font(name='Arial', bold=True, size=10, color='FFFFFFFF')
    c.fill          = sol('FFCA6F1E')
    c.alignment     = aln('right', 'center')

    for i in range(26, 32):
        ws.cell(tot_r, i).fill = sol('FFCA6F1E')

    print(f'  Master BOQs sheet: {len(all_master)} items  |  '
          f'Total Amount: {meta.get("currency","AED")} {total_amount:,.2f}')


def detect_currency(ws) -> str:
    """Scan first 10 rows for a header containing a currency code."""
    for row in ws.iter_rows(min_row=1, max_row=10):
        for cell in row:
            val = str(cell.value or '')
            m = re.search(r'\b(AED|USD|GBP|EUR|SAR|QAR|KWD|OMR|BHD)\b', val, re.I)
            if m:
                return m.group(1).upper()
    return 'AED'


def detect_project_meta(wb, api_key: str = '', bill_path: str = '') -> dict:
    """
    Extract project metadata from a BOQ workbook using AI.
    Scans cover/summary sheets in the bill file and any summary file
    found in the same folder. Sends raw text to AI — no hardcoded patterns.
    Returns a dict; empty string = not found.
    CLI params always override whatever is returned here.
    """
    import urllib.request, json as _json

    EMPTY = {
        'project': '', 'employer': '', 'contractor': '', 'country': '',
        'city': '', 'type': '', 'contract_type': '', 'tender_date': '',
        'award_date': '', 'status': '', 'currency': '',
    }

    def _wb_to_text(workbook, max_rows=80) -> str:
        """Flatten all sheets that look like cover/summary into plain text."""
        COVER = re.compile(r'cover|summary|title|front|contents|index', re.I)
        sheets = [s for s in workbook.sheetnames if COVER.search(s)] or workbook.sheetnames[:2]
        lines = []
        for sname in sheets[:2]:
            ws = workbook[sname]
            for row in ws.iter_rows(min_row=1, max_row=max_rows, values_only=True):
                parts = [str(v).strip() for v in row if v is not None and str(v).strip()]
                if parts:
                    lines.append('  |  '.join(parts))
        return '\n'.join(lines)

    # ── Gather text: prefer summary file in folder, fallback to bill itself ───
    raw_text = ''
    if bill_path:
        folder = os.path.dirname(os.path.abspath(bill_path))
        SUMMARY = re.compile(r'summary|main|cover|tender', re.I)
        for fname in sorted(os.listdir(folder)):
            if not fname.endswith('.xlsx') or fname.endswith('_POMI_Coded.xlsx'):
                continue
            if SUMMARY.search(fname):
                try:
                    wb_s = load_workbook(os.path.join(folder, fname), data_only=True)
                    raw_text = _wb_to_text(wb_s)
                    if raw_text.strip():
                        break
                except Exception:
                    pass
    if not raw_text.strip():
        raw_text = _wb_to_text(wb)

    # Always detect currency via header scan (reliable, no AI needed)
    first_ws = wb[wb.sheetnames[0]]
    currency = detect_currency(first_ws)

    if not raw_text.strip() or not api_key:
        if not api_key:
            print('  ⚠  No API key — skipping AI meta extraction')
        return {**EMPTY, 'currency': currency}

    # ── Send raw text to AI — let it figure out the format ───────────────────
    FIELDS = list(EMPTY.keys())
    FIELDS.remove('currency')   # already detected

    prompt = (
        "You are reading the cover sheet of a construction Bill of Quantities (BOQ).\n"
        "Extract the project metadata from the text below.\n\n"
        "Return ONLY a JSON object with exactly these keys:\n"
        f"{_json.dumps({k: '' for k in FIELDS})}\n\n"
        "Rules:\n"
        "- Use empty string for any field not found\n"
        "- Dates in DD/MM/YYYY format\n"
        "- contract_type: e.g. 'Lump Sum', 'Remeasured', 'GMP', 'Cost Plus'\n"
        "- type: e.g. 'Commercial', 'Residential', 'Mixed Use', 'Infrastructure'\n"
        "- No markdown, no preamble, JSON only\n\n"
        f"Text:\n{raw_text[:3000]}"
    )

    try:
        body = _json.dumps({
            'model':      'claude-haiku-4-5-20251001',
            'max_tokens': 400,
            'messages':   [{'role': 'user', 'content': prompt}]
        }).encode()
        req = urllib.request.Request(
            'https://api.anthropic.com/v1/messages',
            data=body,
            headers={
                'Content-Type':      'application/json',
                'x-api-key':         api_key,
                'anthropic-version': '2023-06-01',
            })
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = _json.loads(resp.read())

        raw = ''.join(b['text'] for b in data.get('content', []) if b.get('type') == 'text')
        raw = re.sub(r'```json\s*|```\s*', '', raw).strip()
        ai_vals = _json.loads(raw)

        result = {**EMPTY, 'currency': currency}
        for k in FIELDS:
            v = str(ai_vals.get(k, '')).strip()
            if v:
                result[k] = v

        found = {k: v for k, v in result.items() if v}
        print(f'  🤖  AI detected meta: {found}')
        return result

    except Exception as e:
        print(f'  ⚠  AI meta extraction failed: {e}')
        return {**EMPTY, 'currency': currency}


def process_one_file(engine, args, bill_path, out_path, meta=None):
    """
    Process a single BQ file. Returns all_master list for the file.
    Saves the individual coded workbook to out_path.
    """
    if meta is None:
        meta = {}
    print(f'\n  Loading: {bill_path}')
    wb_in = load_workbook(bill_path, data_only=True)

    # Auto-detect project metadata from cover sheet
    detected = detect_project_meta(wb_in, api_key=engine.api_key, bill_path=bill_path)
    # CLI params take priority — only fill gaps from detection
    merged_meta = {**detected, **{k: v for k, v in meta.items() if v}}
    meta = merged_meta

    asset_fallback = os.path.basename(os.path.dirname(os.path.abspath(bill_path)))
    batch_name     = os.path.basename(bill_path)

    sheets_to_process = args.sheets if args.sheets else wb_in.sheetnames
    skip_patterns = re.compile(
        r'summary|total|cover|index|content|instruction|how.to', re.I)
    sheets_to_process = [s for s in sheets_to_process
                         if not skip_patterns.search(s)]
    print(f'  Sheets to code: {len(sheets_to_process)}')
    for s in sheets_to_process:
        print(f'    • {s}')

    wb_out        = Workbook()
    wb_out.remove(wb_out.active)
    sheet_totals  = []
    all_flagged   = []
    all_master    = []
    project_title = os.path.splitext(os.path.basename(bill_path))[0]

    for sname in sheets_to_process:
        if sname not in wb_in.sheetnames:
            print(f'\n  ⚠  Sheet not found: {sname} — skipping')
            continue

        ws_src   = wb_in[sname]
        col_map  = detect_columns(ws_src)
        all_rows = read_sheet_items(ws_src, col_map)

        priced = [row for row in all_rows
                  if (row['item_ref'] is not None
                      and row['description'] is not None
                      and not row['is_collection']
                      and not row['is_blank'])]

        descriptions  = [str(row['description']) for row in priced]
        sheet_label   = re.sub(r'^Bill\s+\d+\s*[-–]?\s*', '', sname).strip()
        project_label = re.sub(r'_\d{2}\.\d{2}\.\d{4}.*$', '', project_title)[:35]
        batch_context = f"{project_label} | {sheet_label}"

        last_ctx = ''
        ctx_map  = {}
        priced_i = 0
        for row in all_rows:
            if row.get('is_header') and row.get('description'):
                txt = str(row['description']).strip()
                if txt and not txt.startswith('Note') and not txt.startswith('1)') \
                        and not txt.startswith('2)') and not txt.startswith('3)') \
                        and len(txt) < 80:
                    last_ctx = txt[:60]
            if (row.get('item_ref') is not None and row.get('description') is not None
                    and not row.get('is_collection') and not row.get('is_blank')):
                ctx_map[priced_i] = last_ctx
                priced_i += 1

        contexts = []
        for i in range(len(priced)):
            ctx   = ctx_map.get(i, '')
            parts = [sheet_label]
            if ctx and ctx.lower() not in str(priced[i]['description']).lower()[:len(ctx)]:
                parts.append(ctx)
            contexts.append(' > '.join(parts) if parts else '')

        print(f'\n  ── {sname}  ({len(all_rows)} rows, {len(descriptions)} items to code) ──')

        results = engine.code_items(
            descriptions,
            use_ai        = args.ai,
            batch_size    = args.batch,
            contexts      = contexts,
            batch_context = batch_context)

        for i, row in enumerate(priced):
            row['_result'] = results[i] if i < len(results) else None

        result_list = [row['_result'] for row in priced]

        rule_n = fuzzy_n = ai_n = flag_n = 0
        for r in results:
            if not r: continue
            if r['stage'] == 'rule':  rule_n  += 1
            if r['stage'] == 'fuzzy': fuzzy_n += 1
            if r['stage'] == 'ai':    ai_n    += 1
            if r['confidence'] < 85 and r['pomi_code']:
                flag_n += 1
                for row in priced:
                    if row['_result'] is r:
                        all_flagged.append({
                            'sheet': sname, 'src_row': row['src_row'],
                            'item_ref': row['item_ref'], 'desc': row['description'],
                            'qty': row['qty'], 'unit': row['unit'],
                            'rate': row['rate'], 'amount': row['amount'],
                            'result': r,
                        })
                        break

        for row in priced:
            r    = row['_result']
            hier = engine.get_hierarchy(r['pomi_code']) if r and r.get('pomi_code') else {}
            all_master.append({
                'sheet':          f"{project_title} | {sname}",
                'batch':          batch_name,
                'item_ref':       row['item_ref'],
                'description':    row['description'],
                'qty':            row['qty'],
                'unit':           row['unit'],
                'rate':           row['rate'],
                'amount':         row['amount'],
                'currency':       meta.get('currency', 'AED'),
                'asset_fallback': asset_fallback,
                'hier':           hier,
                'result':         r,
            })

        coded, _ = write_data_sheet(wb_out, sname, all_rows, result_list, project_title)
        sheet_totals.append((sname, len(all_rows), coded, rule_n, fuzzy_n, ai_n, flag_n))
        pct = round((rule_n + ai_n) / coded * 100) if coded else 0
        print(f'  ✓  coded:{coded}  rule:{rule_n}  fuzzy:{fuzzy_n}  '
              f'ai:{ai_n}  ⚠:{flag_n}  auto:{pct}%')

    if all_master:
        write_master_sheet(wb_out, all_master, project_title, meta=meta)
    if all_flagged:
        write_flagged_sheet(wb_out, all_flagged)
        print(f'\n  ⚠  Flagged: {len(all_flagged)} items')

    args_info = (f'Rules: {len(engine.lookup_rows and [1] or [])} | '
                 f'AI: {"on" if args.ai else "off"} | Batch: {args.batch}')
    write_summary_sheet(wb_out, sheet_totals, project_title, args_info)
    wb_out.save(out_path)

    # Save auto-learned rules
    rules_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'pomi_rules.py')
    n_new = engine.save_new_rules(rules_path)
    if n_new:
        print(f'  📚  Learned {n_new} new rules this run → pomi_rules.py')

    total_rows  = sum(t[2] for t in sheet_totals)
    grand_total = sum(i['amount'] for i in all_master
                      if isinstance(i.get('amount'), (int, float)))
    print(f'  ✅  SAVED → {out_path}  |  {total_rows} items  |  AED {grand_total:,.2f}')
    return all_master


# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(
        description='Universal POMI BQ Auto-Coder',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    parser.add_argument('pomi',    help='POMI_CODING_FINAL.xlsx')
    parser.add_argument('bill',    help='Input BQ Excel file OR folder path')
    parser.add_argument('--out',   default='',
                        help='Output filename (default: <input>_POMI_Coded.xlsx)')
    parser.add_argument('--ai',    action='store_true',
                        help='Enable AI coding for unmatched items')
    parser.add_argument('--batch', type=int, default=10,
                        help='AI batch size (default 10)')
    parser.add_argument('--api-key', default='',
                        help='Anthropic API key')
    parser.add_argument('--sheets', nargs='+', default=[],
                        help='Only process these sheet names')
    # Project metadata params (fill every row in MASTER BOQ)
    parser.add_argument('--country',       default='', help='Country (e.g. UAE)')
    parser.add_argument('--city',          default='', help='City (e.g. Dubai)')
    parser.add_argument('--asset',         default='', help='Asset name (e.g. AKAM)')
    parser.add_argument('--project',       default='', help='Project / villa name')
    parser.add_argument('--type',          default='', help='Asset type (e.g. Commercial)')
    parser.add_argument('--employer',      default='', help='Employer name')
    parser.add_argument('--contractor',    default='', help='Contractor name')
    parser.add_argument('--status',        default='', help='Project status')
    parser.add_argument('--contract-type', default='', help='Contract type (e.g. Lump Sum)')
    parser.add_argument('--tender-date',   default='', help='Tender date (e.g. 21/02/2024)')
    parser.add_argument('--award-date',    default='', help='Award date')
    parser.add_argument('--currency',      default='', help='Currency code (default: auto-detect, fallback AED)')
    args = parser.parse_args()

    # Build meta dict from CLI params
    meta = {
        'country':       args.country,
        'city':          args.city,
        'asset':         args.asset,
        'project':       args.project,
        'type':          args.type,
        'employer':      args.employer,
        'contractor':    args.contractor,
        'status':        args.status,
        'contract_type': getattr(args, 'contract_type', ''),
        'tender_date':   getattr(args, 'tender_date', ''),
        'award_date':    getattr(args, 'award_date', ''),
        'currency':      args.currency,
    }

    if not os.path.exists(args.pomi):
        print(f'  ✗  File not found: {args.pomi}'); sys.exit(1)

    # ── Folder mode: process all xlsx files in folder ─────────────────────────
    if os.path.isdir(args.bill):
        folder       = args.bill
        bill_files   = sorted(f for f in os.listdir(folder)
                              if f.endswith('.xlsx') and not f.endswith('_POMI_Coded.xlsx'))
        if not bill_files:
            print(f'  ✗  No .xlsx files found in {folder}'); sys.exit(1)

        print(f"""
{'='*70}
  POMI FOLDER BATCH RUN
  Folder : {folder}
  Files  : {len(bill_files)}
  AI     : {'ON (batch=' + str(args.batch) + ')' if args.ai else 'OFF'}
{'='*70}""")

        folder_master   = []   # combined master across all files
        folder_cost     = 0.0
        folder_in_tok   = 0
        folder_out_tok  = 0
        folder_grand    = 0.0
        pass_n = fail_n = 0

        engine = BQCodingEngine(
            pomi_path = args.pomi,
            api_key   = args.api_key or os.environ.get('ANTHROPIC_API_KEY', ''))

        for bill_file in bill_files:
            bill_path = os.path.join(folder, bill_file)
            print(f'\n{"─"*70}')
            print(f'  ▶  {bill_file}')
            try:
                file_master = process_one_file(
                    engine, args, bill_path,
                    out_path=os.path.splitext(bill_path)[0] + '_POMI_Coded.xlsx',
                    meta=meta)
                folder_master.extend(file_master)
                folder_grand   += sum(i['amount'] for i in file_master
                                      if isinstance(i.get('amount'), (int, float)))
                pass_n += 1
            except Exception as e:
                print(f'  ✗  ERROR: {e}')
                fail_n += 1

        folder_in_tok  = engine.total_in_tok
        folder_out_tok = engine.total_out_tok
        folder_cost    = (folder_in_tok / 1_000_000 * engine._PRICE_IN +
                          folder_out_tok / 1_000_000 * engine._PRICE_OUT)

        # Write combined master workbook
        if folder_master:
            master_path = os.path.join(folder, 'PROJECT_MASTER_BOQ.xlsx')
            wb_master   = Workbook()
            wb_master.remove(wb_master.active)
            project_title = os.path.basename(folder)
            write_master_sheet(wb_master, folder_master, project_title, meta=meta)
            wb_master.save(master_path)
            print(f'\n  ✅  PROJECT MASTER BOQ → {master_path}')

        print(f"""
{'='*70}
  BATCH COMPLETE
  ✅  Passed      : {pass_n} / {len(bill_files)}
  ❌  Failed      : {fail_n}
{'─'*70}
  🤖  AI Tokens   : {folder_in_tok:,} in  /  {folder_out_tok:,} out
  💵  AI Cost     : ${folder_cost:.4f} USD
{'─'*70}
  💰  GRAND TOTAL : AED {folder_grand:>20,.2f}
{'='*70}
""")
        return

    # ── Single file mode ──────────────────────────────────────────────────────
    if not os.path.exists(args.bill):
        print(f'  ✗  File not found: {args.bill}'); sys.exit(1)

    out_path = args.out or (
        os.path.splitext(args.bill)[0] + '_POMI_Coded.xlsx')

    print(f"""
{'='*70}
  POMI UNIVERSAL BQ AUTO-CODER
  Input : {os.path.basename(args.bill)}
  POMI  : {os.path.basename(args.pomi)}
  AI    : {'ON  (batch=' + str(args.batch) + ')' if args.ai else 'OFF  (rules + fuzzy only)'}
  Output: {os.path.basename(out_path)}
{'='*70}""")

    engine = BQCodingEngine(
        pomi_path = args.pomi,
        api_key   = args.api_key or os.environ.get('ANTHROPIC_API_KEY', ''))

    all_master = process_one_file(engine, args, args.bill, out_path, meta=meta)

    in_tok  = engine.total_in_tok
    out_tok = engine.total_out_tok
    ai_cost = (in_tok / 1_000_000 * engine._PRICE_IN +
               out_tok / 1_000_000 * engine._PRICE_OUT)
    grand_total = sum(i['amount'] for i in all_master
                      if isinstance(i.get('amount'), (int, float)))

    print(f"""
{'─'*70}
  🤖  AI Tokens   : {in_tok:,} in  /  {out_tok:,} out
  💵  AI Cost     : ${ai_cost:.4f} USD
{'─'*70}
  💰  GRAND TOTAL : AED {grand_total:>20,.2f}
{'='*70}
""")



if __name__ == '__main__':
    main()
